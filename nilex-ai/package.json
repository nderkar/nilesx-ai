{
  "name": "nilex-ai",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "bin": {
    "nilex": "dist/cli/index.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "mcp:stdio": "tsx src/mcp/stdio.ts",
    "mcp:http": "tsx src/mcp/http.ts",
    "agent:server": "tsx src/agent/server.ts",
    "agent:repl": "tsx src/agent/repl.ts",
    "cli": "tsx src/cli/index.ts",
    "test:stdio": "npm run build && node dist/mcp/testStdioClient.js",
    "test:http": "npm run build && node dist/mcp/testHttpClient.js",
    "test:disabled-tool": "npm run build && node dist/mcp/testDisabledTool.js",
    "test:agent": "npm run build && node dist/agent/testAgentSession.js"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.112.3",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "commander": "^13.1.0",
    "express": "^4.21.2",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^22.10.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
